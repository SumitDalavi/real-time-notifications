# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: real-time-notifications
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-process WebSocket server with local pub/sub.
#
# TIER 2 / TIER 3: REDIS PUB/SUB ACROSS CLUSTER REPLICAS
# - Connect to Redis cluster for horizontal WebSocket scaling.

REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-replace-in-production
PORT=3001
